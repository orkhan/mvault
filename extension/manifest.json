{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/mvault-192.png",
    "32": "icons/mvault-192.png",
    "48": "icons/mvault-192.png",
    "128": "icons/mvault-512.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/mvault-192.png",
      "32": "icons/mvault-192.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
