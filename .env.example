# mVault configuration for the "slim" image / bare-metal installs. Full reference: docs/configuration.md
# Generate secrets with:  openssl rand -hex 32   (48 for DJANGO_SECRET_KEY)

# --- Required ---------------------------------------------------------------------------------
# Public address users open in the browser (drives allowed hosts, CSRF origin, secure cookies, HSTS).
MVAULT_BASE_URL=https://vault.example.com
DJANGO_SECRET_KEY=
# Field-level encryption. BACK THESE UP somewhere safe: without them stored values cannot be decrypted,
# and changing them later breaks decryption (use `manage.py rotate_encryption_key`).
MVAULT_ENCRYPTION_KEY=
MVAULT_ENCRYPTION_SALT=
# First administrator, created on first start (used only when no admin exists yet).
MVAULT_ADMIN_EMAIL=admin@example.com
MVAULT_ADMIN_PASSWORD=

# --- PostgreSQL (use DATABASE_URL or the DB_* variables) ----------------------------------------
DATABASE_URL=postgres://mvault:change-me@postgres.example.lan:5432/mvault
# DB_HOST=
# DB_PORT=5432
# DB_NAME=mvault
# DB_USER=mvault
# DB_PASSWORD=

# --- S3-compatible object storage (optional: icons, avatars, file records) -------------------------
# Leave empty to run without storage; uploads are then disabled.
S3_ENDPOINT_URL=http://minio.example.lan:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ICONS_BUCKET=mvault-icons
S3_AVATARS_BUCKET=mvault-avatars
S3_ATTACHMENTS_BUCKET=mvault-attachments
# Create missing buckets at start (needs CreateBucket permission). Otherwise create them yourself.
MVAULT_PROVISION_BUCKETS=false
# Optional: serve icons/avatars straight from a public bucket URL instead of through the app.
# ICONS_PUBLIC_BASE_URL=
# AVATARS_PUBLIC_BASE_URL=

# --- Optional ----------------------------------------------------------------------------------
# MVAULT_TIME_ZONE=Europe/Berlin
# MVAULT_LOGIN_MAX_ATTEMPTS=5
# MVAULT_LOGIN_WINDOW_SECONDS=900
# MVAULT_TRUST_PROXY=true
# GUNICORN_WORKERS=3
