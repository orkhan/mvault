# Local-only Django configuration; the app loads .env.local automatically. Never commit it.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
MVAULT_ADMIN_PASSWORD=
MVAULT_SEED_PASSWORD=
SESSION_COOKIE_SECURE=false

DB_ENGINE=django.db.backends.postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mvault_local
DB_USER=mvault_local
DB_PASSWORD=

# Optional: S3-compatible storage for icons, avatars and file records.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
